# Gemini/AI API Key
# For Tool 2 structurer, the in-app raga assistant and audio raga detection
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# Optional override for every Gemini text call (chat, suggest, detect-raga).
# Defaults to gemini-2.5-flash. Embeddings use models/gemini-embedding-001.
GEMINI_CHAT_MODEL=gemini-2.5-flash

# Google AI / Stitch Key (Same as GEMINI_API_KEY if using Google AI Studio)
X_GOOG_API_KEY=YOUR_GOOGLE_AI_KEY

# Supabase project URL for the web app
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL

# Supabase anon key for the web app (Public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Supabase service role key (Server-side ONLY, never expose to browser)
# Required for seed scripts and backend bypass
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# The deployed app URL (http://localhost:3000 in development)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Fallback LLM providers (server-only). Used by chat, mood, generate and
# beat-suggest when Gemini fails; leave blank to disable that provider.
GROQ_API_KEY=YOUR_GROQ_API_KEY
NVIDIA_API_KEY=YOUR_NVIDIA_API_KEY
