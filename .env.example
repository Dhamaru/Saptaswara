# Gemini/AI API Key
# For Tool 2 structurer and the in-app raga assistant
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Google AI / Stitch Key (Same as GEMINI_API_KEY if using Google AI Studio)
X_GOOG_API_KEY=YOUR_GOOGLE_AI_KEY

# Supabase project URL for the web app
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL

# Supabase anon key for the web app (Public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Supabase service role key (Server-side ONLY, never expose to browser)
# Required for seed scripts and backend bypass
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# The deployed app URL (http://localhost:3000 in development)
NEXT_PUBLIC_APP_URL=http://localhost:3000

