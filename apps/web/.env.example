# Supabase — get these from your project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
# Optional override for chat, suggest and audio raga detection.
# Defaults to gemini-2.5-flash (gemini-1.5-pro is retired).
GEMINI_CHAT_MODEL=gemini-2.5-flash

# Fallback LLM providers for chat / mood / generate / beat-suggest.
# Both optional; the chat route falls back to whichever is configured.
GROQ_API_KEY=your-groq-api-key
NVIDIA_API_KEY=your-nvidia-api-key

# App URL (used for auth redirect; set to production URL in Vercel)
NEXT_PUBLIC_APP_URL=http://localhost:3000
